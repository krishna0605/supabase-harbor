{
  "name": "supabase-harbor",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@better-auth/passkey": "1.6.25",
    "better-auth": "1.6.25",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 47832",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 47832",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "worker:sweep": "tsx scripts/run-keepalive-worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "keys:rotate": "tsx scripts/rotate-master-key.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.4.2-beta",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.101.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.26.0",
    "motion": "12.42.2",
    "next": "16.2.11",
    "p-limit": "7.3.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
