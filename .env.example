# Copy to .env.local and replace the placeholders with Neon connection strings.
# Use the pooled host for runtime traffic and the direct host for migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Test values belong in .env.test.local and must target a database named harbor_test.
TEST_DATABASE_URL=postgresql://user:password@ep-test-pooler.us-east-2.aws.neon.tech/harbor_test?sslmode=require
TEST_DATABASE_URL_UNPOOLED=postgresql://user:password@ep-test.us-east-2.aws.neon.tech/harbor_test?sslmode=require
ALLOW_DATABASE_RESET=1

# Non-secret local web settings.
HARBOR_PORT=47832
HARBOR_LOG_LEVEL=info
